migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Il keystore e le credenziali di firma sono configurati localmente.
android/key.properties
*.jks
*.keystore

# Le immagini dei fallimenti dei golden sono artefatti di una esecuzione, non
# materiale del progetto: si rigenerano a ogni fallimento.
test/goldens/failures/

# Le APK consegnate (24 MB l`una): si ricostruiscono, non stanno in git
dist/

# Ambiente di sviluppo e configurazioni locali
/_env/
**/.firebase/
**/.firebase-debug.log*
**/.env
**/.env.*
!**/.env.example
**/local.properties
**/client_secret*.json
**/credentials.json

