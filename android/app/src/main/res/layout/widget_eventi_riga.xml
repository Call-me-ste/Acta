<?xml version="1.0" encoding="utf-8"?>
<!-- Una riga della collection 2x2: barra colore, ora, titolo, segno todo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/evento_riga_radice"
    android:layout_width="match_parent"
    android:layout_height="38dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/evento_riga_barra"
        android:layout_width="3dp"
        android:layout_height="24dp"
        android:layout_marginEnd="6dp" />

    <TextView
        android:id="@+id/evento_riga_ora"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="10:00"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/evento_riga_titolo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/evento_riga_todo"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:scaleType="centerInside"
        android:src="@drawable/widget_spunta_vuota"
        android:visibility="gone" />
</LinearLayout>
