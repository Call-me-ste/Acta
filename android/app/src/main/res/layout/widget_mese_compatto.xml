<?xml version="1.0" encoding="utf-8"?>
<!-- «Mese compatto» 2x2: solo la griglia, mese e oggi evidenti. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mese_radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/mese_intestazione"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mese_titolo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:paddingStart="1dp"
            android:text="Ottobre 2026"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/mese_indietro"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/widget_mese_precedente"
            android:gravity="center"
            android:text="‹"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/mese_avanti"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/widget_mese_successivo"
            android:gravity="center"
            android:text="›"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mese_settimana"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mese_giorno_lun"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="L"
            android:textSize="7sp" />

        <TextView
            android:id="@+id/mese_giorno_mar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="M"
            android:textSize="7sp" />

        <TextView
            android:id="@+id/mese_giorno_mer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="M"
            android:textSize="7sp" />

        <TextView
            android:id="@+id/mese_giorno_gio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="G"
            android:textSize="7sp" />

        <TextView
            android:id="@+id/mese_giorno_ven"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="V"
            android:textSize="7sp" />

        <TextView
            android:id="@+id/mese_giorno_sab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="S"
            android:textSize="7sp" />

        <TextView
            android:id="@+id/mese_giorno_dom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="D"
            android:textSize="7sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mese_griglia"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="1dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/mese_nota"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="7sp"
        android:visibility="gone" />
</LinearLayout>
