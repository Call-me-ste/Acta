<?xml version="1.0" encoding="utf-8"?>
<!-- Una settimana del mese: pesa 1 sull'altezza della griglia, così il mese
     riempie davvero il widget su qualunque launcher. Le celle si aggiungono
     direttamente a questo root (id unico per riga). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mese_riga_g1"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal" />
