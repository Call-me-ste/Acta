<?xml version="1.0" encoding="utf-8"?>
<!-- Un giorno della fascia del widget «Giorno»: nome, numero, cerchio. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/giorno_radice"
    android:layout_width="52dp"
    android:layout_height="48dp"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/giorno_nome"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:text="sab"
        android:textSize="9sp" />

    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/giorno_cerchio"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_cerchio"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/giorno_numero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:text="24"
            android:textSize="16sp" />
    </FrameLayout>

    <ImageView
        android:id="@+id/giorno_oggi"
        android:layout_width="3dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_punto"
        android:visibility="invisible" />
</LinearLayout>
