<?xml version="1.0" encoding="utf-8"?>
<!-- Cella del mese 4x4: numero leggibile, cerchio del giorno e pallini eventi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cella_radice"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/cella_cerchio"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_cerchio"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/cella_numero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="1"
            android:textFontWeight="700"
            android:textSize="13sp"
            android:textStyle="bold"
            android:typeface="sans" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/cella_punti"
        android:layout_width="wrap_content"
        android:layout_height="7dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/cella_punto_1"
            android:layout_width="10dp"
            android:layout_height="2dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_barra"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/cella_punto_2"
            android:layout_width="10dp"
            android:layout_height="2dp"
            android:layout_marginTop="1dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_barra"
            android:visibility="gone" />

        <!-- Il «+N» resta nel layout per il contratto, ma non si mostra:
             sotto i numeri vince la barra, non una cifra da 8 sp. -->
        <TextView
            android:id="@+id/cella_piu"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:maxLines="1"
            android:textSize="8sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
