<?xml version="1.0" encoding="utf-8"?>
<!--
  «Mese + giorno» 4x4 — hero e mese in alto, poi eventi e To do come righe
  statiche. La barra dei To do è una sola, in fondo, sopra la lista.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mese_radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.53"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.36"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mese_eyebrow"
                android:layout_width="match_parent"
                android:layout_height="19dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/mese_giorno_nome"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/mese_giorno_numero"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/mese_conteggio"
                android:layout_width="match_parent"
                android:layout_height="19dp"
                android:layout_marginTop="3dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.64"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mese_indietro"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/widget_mese_precedente"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/mese_titolo"
                    android:layout_width="0dp"
                    android:layout_height="22dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/mese_avanti"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/widget_mese_successivo"
                    android:scaleType="fitXY" />
            </LinearLayout>

            <ImageView
                android:id="@+id/mese_settimana_immagine"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <LinearLayout
                android:id="@+id/mese_griglia"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="1dp"
                android:layout_weight="1"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/mese_divisore"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mese_giorno_titolo"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/mese_nuovo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_aggiungi_evento"
            android:scaleType="fitXY" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.47">

        <LinearLayout
            android:id="@+id/mese_eventi"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="36dp" />

        <LinearLayout
            android:id="@+id/mese_todo_righe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="36dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/mese_todo_barra"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/mese_nota"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_mese_fuori_finestra"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>
