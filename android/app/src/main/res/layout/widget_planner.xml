<?xml version="1.0" encoding="utf-8"?>
<!--
  «Giorno» 4x4: testata fissa, fascia di cinque giorni selezionabili e lista
  ampia. La testata e la fascia non si muovono quando la lista è vuota.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/widget_intestazione"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="vertical"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/widget_titolo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Oggi · Sab 24 ott"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/widget_conteggi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="1 evento · 5 To do"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_giorni"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp">

        <LinearLayout
            android:id="@+id/widget_righe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/widget_stato_riga"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_stato_icon"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="＋"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/widget_stato"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:text="Niente in programma per oggi."
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
