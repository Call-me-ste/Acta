<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 «Countdown»: nome, numero grande, data; senza scelta, + Scegli evento. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown_radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/countdown_titolo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="Countdown"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/countdown_numero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="0"
        android:textSize="32sp" />

    <TextView
        android:id="@+id/countdown_sotto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/countdown_frase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Scegli evento"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/countdown_piu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="+"
        android:textSize="26sp"
        android:visibility="gone" />
</LinearLayout>
