<?xml version="1.0" encoding="utf-8"?>
<!-- Cella del mese 4x2: numero leggibile, cerchio tenue su oggi/scelto,
     due pallini per gli eventi. Niente titoli: a 4x2 sarebbero troncati. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cella_radice"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/cella_cerchio"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_cerchio"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/cella_numero"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:text="1"
            android:textSize="9sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/cella_punti"
        android:layout_width="wrap_content"
        android:layout_height="2dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/cella_punto_1"
            android:layout_width="2dp"
            android:layout_height="2dp"
            android:layout_marginEnd="1dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_punto"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/cella_punto_2"
            android:layout_width="2dp"
            android:layout_height="2dp"
            android:scaleType="fitXY"
            android:src="@drawable/widget_punto"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
